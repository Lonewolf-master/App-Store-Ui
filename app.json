{
  "expo": {
    "name": "App-Store",
    "slug": "App-Store",
    "version": "1.0.0",
    "scheme": "app-store",
    "platforms": [
      "ios",
      "android"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/App-store.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/App-store.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/App-store.png",
        "backgroundColor": "#ffffff"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d89dc53b-b5e0-42c1-ac5d-ab0cf508fe55"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d89dc53b-b5e0-42c1-ac5d-ab0cf508fe55"
      }
    }
  }
}
